# Bind + port. 0.0.0.0 so the phone on your LAN can reach it during QR sideload.
HOST=0.0.0.0
PORT=8787

# Required before this server is reachable by anything but you.
# Write side: every POST /ingest must send `Authorization: Bearer <INGEST_TOKEN>`.
INGEST_TOKEN=change-me-to-a-long-random-string

# Read side: leave empty while developing on your LAN.
# If you set it, the glasses plugin must send it too — and it must NOT be baked
# into the .ehpk. Enter it once on the phone and let the plugin keep it in
# localStorage. Anything bundled in the package can be extracted.
READ_TOKEN=

# Tighten this from * once you know the plugin's WebView origin.
ALLOWED_ORIGIN=*

# --- Slack, Socket Mode (recommended: outbound only, no public URL) ---
# App-level token, starts xapp-. Needs connections:write.
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=

# --- Slack, Events API over HTTP (only if this server has a public HTTPS URL) ---
SLACK_SIGNING_SECRET=

# Where mutable local state is written. This directory holds checklist runs,
# shared-list state, jobs, Coach/listening sessions, and the value snapshot.
# Do not put it in packages.
DATA_DIR=./data
PERSIST_PATH=./data/values.json

# Foreground Coach cues for the glasses. These are small list-aware recaps,
# not autonomous actions.
AI_CUE_INTERVAL_MS=120000

# Optional: also send each non-quiet cue through NOTIFY_URL. Leave off while
# tuning wording and cadence.
AI_CUE_NOTIFY=0
AI_CUE_SPACES=ops

# Speech-to-text for glasses Listen sessions. The key stays on the hub; never
# bake it into the .ehpk. Deepgram's REST listen endpoint is the default.
# local = whisper.cpp on this Mac. The default on purpose: no metered API, and
# conversation audio never leaves the machine.
#   brew install whisper-cpp
#   curl -L -o ~/whisper-models/ggml-base.en.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
# Then set STT_LOCAL_MODEL to that path.
STT_PROVIDER=local
STT_LOCAL_BIN=whisper-cli
STT_LOCAL_MODEL=
STT_LOCAL_THREADS=4
# Off by default. When set, every accepted Listen chunk is written as the exact
# WAV handed to transcription. Use briefly while debugging, then unset it.
STT_DEBUG_DIR=

# Cloud fallbacks. Opt-in only — these bill per minute and send audio offsite.
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=en
STT_SMART_FORMAT=true
STT_SAMPLE_RATE=16000
STT_CHANNELS=1
